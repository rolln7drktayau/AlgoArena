{
  "name": "algoarena-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "AlgoArena desktop shell (Electron)",
  "main": "desktop/main.js",
  "author": "AST & RCT",
  "license": "UNLICENSED",
  "scripts": {
    "local:backend": "python -m uvicorn backend.app.main:app --host 0.0.0.0 --port 8000",
    "local:frontend": "npm --prefix frontend run dev -- --host 0.0.0.0 --port 5173",
    "local:dev": "node scripts/local_dev.js",
    "local:stop": "powershell -ExecutionPolicy Bypass -File .\\scripts\\stop_local_dev.ps1",
    "local:build": "npm --prefix frontend run build",
    "local:test": "python -m pytest backend/tests && npm --prefix frontend run test",
    "pages:serve": "npx http-server docs -p 4174 -c-1",
    "screenshots:v2": "node scripts/capture_v2_screenshots.mjs",
    "cli:algorithms": "python -m algoarena_cli algorithms",
    "cli:domain-smoke": "python -m algoarena_cli domain-run --kind tsp --iterations 40",
    "desktop:prepare": "npm --prefix frontend run build",
    "desktop:dev": "npm run desktop:prepare && electron .",
    "dist": "npm run desktop:prepare && electron-builder",
    "dist:win": "npm run desktop:prepare && electron-builder --win nsis",
    "dist:linux": "npm run desktop:prepare && electron-builder --linux deb rpm",
    "dist:mac": "npm run desktop:prepare && electron-builder --mac dmg",
    "desktop:dist:win": "npm run dist:win"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.8.1",
    "playwright": "^1.60.0"
  },
  "build": {
    "appId": "com.algoarena.desktop",
    "productName": "AlgoArena Desktop",
    "icon": "desktop/assets/icon-taskbar.ico",
    "asar": false,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "desktop/**/*",
      "backend/**/*",
      "algorithms/**/*",
      "problems/**/*",
      "Workflows/**/*",
      "frontend/dist/**/*",
      "scripts/**/*",
      "package.json",
      "QUICK_START_COMMANDS.txt",
      "GUIDE_COMPLET_FR.md"
    ],
    "extraMetadata": {
      "main": "desktop/main.js"
    },
    "win": {
      "icon": "desktop/assets/icon-taskbar.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "deb",
        "rpm"
      ],
      "category": "Utility",
      "maintainer": "AST & RCT <support@algoarena.local>",
      "icon": "desktop/assets/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "desktop/assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "desktop/assets/icon-taskbar.ico",
      "uninstallerIcon": "desktop/assets/icon-taskbar.ico",
      "installerHeaderIcon": "desktop/assets/icon-taskbar.ico"
    }
  }
}
