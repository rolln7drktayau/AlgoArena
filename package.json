{
  "name": "algoarena-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "AlgoArena desktop shell (Electron)",
  "main": "desktop/main.js",
  "author": "AST & RCT",
  "license": "UNLICENSED",
  "scripts": {
    "desktop:prepare": "npm --prefix frontend run build",
    "desktop:dev": "npm run desktop:prepare && electron .",
    "desktop:dist:win": "npm run desktop:prepare && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.algoarena.desktop",
    "productName": "AlgoArena Desktop",
    "asar": false,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "desktop/**/*",
      "backend/**/*",
      "frontend/dist/**/*",
      "scripts/**/*",
      "package.json",
      "QUICK_START_COMMANDS.txt",
      "GUIDE_COMPLET_FR.md"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  }
}
